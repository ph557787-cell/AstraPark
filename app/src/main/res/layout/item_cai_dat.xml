<?xml version="1.0" encoding="utf-8"?>
<!-- Item menu cài đặt -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_stats"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Icon -->
    <ImageView
        android:id="@+id/imgIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_settings"
        android:padding="8dp"
        android:background="@drawable/bg_gradient_gold"
        android:contentDescription="Icon"/>

    <!-- Nội dung -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/txtTieuDe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cấu hình giá"
            android:textColor="@color/trang_tinh_khiet"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- Mô tả -->
        <TextView
            android:id="@+id/txtMoTa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thiết lập giá đỗ xe"
            android:textColor="@color/xam_platinum"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Mũi tên -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_right"
        app:tint="@color/vang_gold"
        android:contentDescription="Arrow"/>

</LinearLayout>