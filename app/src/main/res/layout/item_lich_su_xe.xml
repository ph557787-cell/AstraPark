<?xml version="1.0" encoding="utf-8"?>
<!-- Layout cho 1 bản ghi lịch sử -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_stats"
        android:padding="16dp">

        <!-- Header: Biển số + Badge trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Biển số xe -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtBienSoXe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="51A-123.45"
                    android:textColor="@color/vang_gold"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chỗ "
                        android:textColor="@color/xam_platinum"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/txtChoDo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Badge trạng thái -->
            <TextView
                android:id="@+id/txtBadgeTrangThai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Đã ra"
                android:textColor="@color/trang_tinh_khiet"
                android:textSize="12sp"
                android:background="@drawable/badge_success"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#20D4AF37"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Thời gian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Icon clock -->
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center_vertical"
                app:tint="@color/xam_platinum"
                android:contentDescription="Time"/>

            <!-- Thời gian vào -->
            <TextView
                android:id="@+id/txtThoiGianVao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30 - 24/10/2024"
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"/>

            <!-- Mũi tên -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" → "
                android:textColor="@color/vang_gold"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <!-- Thời gian ra -->
            <TextView
                android:id="@+id/txtThoiGianRa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16:45"
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"/>

            <!-- Thời gian đỗ -->
            <TextView
                android:id="@+id/txtThoiGianDo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" (2h 15p)"
                android:textColor="@color/vang_gold"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Tiền + Phương thức -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- Icon tiền -->
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_money"
                android:layout_marginEnd="8dp"
                app:tint="@color/vang_gold"
                android:contentDescription="Money"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiền: "
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/txtTienPhi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150,000"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" VNĐ"
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" | "
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/txtPhuongThuc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiền mặt"
                android:textColor="@color/trang_tinh_khiet"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Ghi chú (nếu có) -->
        <TextView
            android:id="@+id/txtGhiChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💬 Ghi chú: Khách VIP"
            android:textColor="@color/xam_platinum"
            android:textSize="12sp"
            android:textStyle="italic"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <!-- Nút hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <!-- Nút Chi tiết -->
            <Button
                android:id="@+id/btnChiTiet"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/xem_chi_tiet"
                android:textColor="@color/vang_gold"
                android:textSize="12sp"
                android:background="@drawable/btn_outline_gold"
                android:layout_marginEnd="6dp"/>

            <!-- Nút In hóa đơn -->
            <Button
                android:id="@+id/btnInHoaDon"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/in_hoa_don"
                android:textColor="@color/den_sang_trong"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_luxury"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>