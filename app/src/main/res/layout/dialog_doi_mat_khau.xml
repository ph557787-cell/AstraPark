<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog đổi mật khẩu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_luxury"
    android:padding="24dp">

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/doi_mat_khau"
        android:textColor="@color/vang_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Mật khẩu cũ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mat_khau_cu"
        android:textColor="@color/vang_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"/>

    <EditText
        android:id="@+id/edtMatKhauCu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập mật khẩu cũ"
        android:textColorHint="#80E5E5E5"
        android:textColor="@color/trang_tinh_khiet"
        android:textSize="16sp"
        android:background="@drawable/bg_input_luxury"
        android:inputType="textPassword"
        android:maxLines="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:padding="16dp"/>

    <!-- Mật khẩu mới -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mat_khau_moi"
        android:textColor="@color/vang_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"/>

    <EditText
        android:id="@+id/edtMatKhauMoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập mật khẩu mới"
        android:textColorHint="#80E5E5E5"
        android:textColor="@color/trang_tinh_khiet"
        android:textSize="16sp"
        android:background="@drawable/bg_input_luxury"
        android:inputType="textPassword"
        android:maxLines="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:padding="16dp"/>

    <!-- Nhập lại mật khẩu mới -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nhap_lai_mat_khau_moi"
        android:textColor="@color/vang_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"/>

    <EditText
        android:id="@+id/edtNhapLaiMatKhauMoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập lại mật khẩu mới"
        android:textColorHint="#80E5E5E5"
        android:textColor="@color/trang_tinh_khiet"
        android:textSize="16sp"
        android:background="@drawable/bg_input_luxury"
        android:inputType="textPassword"
        android:maxLines="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:padding="16dp"/>

    <!-- Nút hành động -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnHuyBo"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/huy_bo"
            android:textColor="@color/xam_platinum"
            android:textSize="15sp"
            android:background="@drawable/btn_outline_gold"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnXacNhan"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/xac_nhan"
            android:textColor="@color/den_sang_trong"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_luxury"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>