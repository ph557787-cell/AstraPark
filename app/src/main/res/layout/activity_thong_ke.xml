<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình thống kê & báo cáo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_luxury">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A000000"
        android:padding="16dp"
        android:elevation="4dp">

        <!-- Nút Back -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"
            app:tint="@color/vang_gold"/>

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/thong_ke_title"
            android:textColor="@color/trang_tinh_khiet"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Nút Xuất báo cáo -->
        <ImageView
            android:id="@+id/btnXuatBaoCao"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_report"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Report"
            app:tint="@color/vang_gold"/>

    </RelativeLayout>

    <!-- Tabs lọc -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNgay"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/ngay"
                android:textColor="@color/den_sang_trong"
                android:textSize="13sp"
                android:background="@drawable/btn_luxury"
                android:minWidth="80dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnTuan"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/tuan"
                android:textColor="@color/vang_gold"
                android:textSize="13sp"
                android:background="@drawable/btn_outline_gold"
                android:minWidth="80dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnThang"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/thang"
                android:textColor="@color/vang_gold"
                android:textSize="13sp"
                android:background="@drawable/btn_outline_gold"
                android:minWidth="80dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnNam"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/nam"
                android:textColor="@color/vang_gold"
                android:textSize="13sp"
                android:background="@drawable/btn_outline_gold"
                android:minWidth="80dp"/>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- ScrollView cho nội dung -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- BIỂU ĐỒ DOANH THU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_stats"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Tiêu đề -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chart_bar"
                        android:contentDescription="Chart"
                        app:tint="@color/vang_gold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bieu_do_doanh_thu"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

                <!-- Biểu đồ -->
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chartDoanhThu"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"/>

            </LinearLayout>

            <!-- BIỂU ĐỒ LƯỢT XE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_stats"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Tiêu đề -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chart_line"
                        android:contentDescription="Chart"
                        app:tint="@color/vang_gold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bieu_do_luot_xe"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

                <!-- Biểu đồ -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chartLuotXe"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"/>

            </LinearLayout>

            <!-- PHƯƠNG THỨC THANH TOÁN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_stats"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Tiêu đề -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chart_pie"
                        android:contentDescription="Chart"
                        app:tint="@color/vang_gold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/phuong_thuc_thanh_toan_title"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

                <!-- Biểu đồ -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/chartPhuongThuc"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"/>

            </LinearLayout>

            <!-- BÁO CÁO TỔNG HỢP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_stats"
                android:padding="16dp">

                <!-- Tiêu đề -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bao_cao_tong_hop"
                    android:textColor="@color/vang_gold"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- Tổng doanh thu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tong_doanh_thu_label"
                        android:textColor="@color/xam_platinum"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txtTongDoanhThu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45,000,000 VNĐ"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- Tổng lượt xe -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tong_luot_xe"
                        android:textColor="@color/xam_platinum"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txtTongLuotXe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="450 lượt"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- Trung bình/ngày -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/trung_binh_ngay"
                        android:textColor="@color/xam_platinum"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txtTrungBinhNgay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1,500,000 VNĐ"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- So sánh kỳ trước -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_input_luxury">

                    <ImageView
                        android:id="@+id/imgTrend"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_trending_up"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Trend"/>

                    <TextView
                        android:id="@+id/txtSoSanh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tăng 15% so với kỳ trước"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- Nút xuất -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnXuatPDF"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:text="@string/xuat_pdf"
                        android:textColor="@color/vang_gold"
                        android:textSize="13sp"
                        android:background="@drawable/btn_outline_gold"
                        android:layout_marginEnd="6dp"/>

                    <Button
                        android:id="@+id/btnXuatExcel"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:text="@string/xuat_excel"
                        android:textColor="@color/den_sang_trong"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_luxury"
                        android:layout_marginStart="6dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>