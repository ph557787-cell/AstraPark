<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình quản lý xe vào/ra -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_luxury">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A000000"
        android:padding="16dp"
        android:elevation="4dp">

        <!-- Nút Back -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"
            app:tint="@color/vang_gold"/>

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/xe_vao_ra_title"
            android:textColor="@color/trang_tinh_khiet"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Nút thêm xe -->
        <ImageView
            android:id="@+id/btnThemXe"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_add"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Add car"
            app:tint="@color/vang_gold"/>

    </RelativeLayout>

    <!-- Thống kê nhanh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="2">

        <!-- Tổng xe đang đỗ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_stats"
            android:padding="16dp"
            android:layout_marginEnd="8dp"
            android:gravity="center">

            <TextView
                android:id="@+id/txtTongXeDangDo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="@color/trang_tinh_khiet"
                android:textSize="32sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xe đang đỗ"
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Doanh thu dự kiến -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_stats"
            android:padding="16dp"
            android:layout_marginStart="8dp"
            android:gravity="center">

            <TextView
                android:id="@+id/txtDoanhThuDuKien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.5M"
                android:textColor="@color/vang_gold"
                android:textSize="32sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doanh thu dự kiến"
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Tiêu đề danh sách -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/danh_sach_xe_dang_do"
        android:textColor="@color/trang_tinh_khiet"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Danh sách xe -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewXeDangDo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_parking_empty"
            android:alpha="0.3"
            android:contentDescription="Empty"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chua_co_xe"
            android:textColor="@color/xam_platinum"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhấn nút + để thêm xe vào"
            android:textColor="@color/xam_platinum"
            android:textSize="13sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</LinearLayout>