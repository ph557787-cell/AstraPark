<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog cấu hình giá đỗ xe -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_luxury"
    android:padding="24dp">

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cau_hinh_gia"
        android:textColor="@color/vang_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Giá theo giờ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gia_oto_gio"
        android:textColor="@color/vang_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"/>

    <EditText
        android:id="@+id/edtGiaGio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nhap_gia"
        android:textColorHint="#80E5E5E5"
        android:textColor="@color/trang_tinh_khiet"
        android:textSize="16sp"
        android:background="@drawable/bg_input_luxury"
        android:inputType="number"
        android:maxLines="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:padding="16dp"/>

    <!-- Giá theo ngày -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gia_oto_ngay"
        android:textColor="@color/vang_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"/>

    <EditText
        android:id="@+id/edtGiaNgay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nhap_gia"
        android:textColorHint="#80E5E5E5"
        android:textColor="@color/trang_tinh_khiet"
        android:textSize="16sp"
        android:background="@drawable/bg_input_luxury"
        android:inputType="number"
        android:maxLines="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:padding="16dp"/>

    <!-- Giá theo tháng -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gia_oto_thang"
        android:textColor="@color/vang_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"/>

    <EditText
        android:id="@+id/edtGiaThang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nhap_gia"
        android:textColorHint="#80E5E5E5"
        android:textColor="@color/trang_tinh_khiet"
        android:textSize="16sp"
        android:background="@drawable/bg_input_luxury"
        android:inputType="number"
        android:maxLines="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:padding="16dp"/>

    <!-- Nút hành động -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnHuyBo"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/huy_bo"
            android:textColor="@color/xam_platinum"
            android:textSize="15sp"
            android:background="@drawable/btn_outline_gold"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnLuu"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/luu_cau_hinh"
            android:textColor="@color/den_sang_trong"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_luxury"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>