<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình Dashboard tổng quan -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_luxury"
    tools:context=".DashboardActivity">

    <!-- Nội dung chính -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <RelativeLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A000000"
                android:padding="16dp"
                android:elevation="4dp">

                <!-- Icon menu -->
                <ImageView
                    android:id="@+id/imgIconMenu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Menu"/>

                <!-- Logo nhỏ -->
                <ImageView
                    android:id="@+id/imgLogoHeader"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_toEndOf="@id/imgIconMenu"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_logo_astrapark"
                    android:contentDescription="@string/ten_app"/>

                <!-- Tên app -->
                <TextView
                    android:id="@+id/txtTenAppHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgLogoHeader"
                    android:layout_marginStart="12dp"
                    android:layout_centerVertical="true"
                    android:text="@string/ten_app"
                    android:textColor="@color/vang_gold"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"/>

                <!-- Xin chào admin -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xin_chao"
                        android:textColor="@color/xam_platinum"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtTenQuanLy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Admin"
                        android:textColor="@color/vang_gold"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </RelativeLayout>

            <!-- THỐNG KÊ NHANH -->
            <LinearLayout
                android:id="@+id/layoutThongKeNhanh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:weightSum="3">

                <!-- Thẻ 1: Tổng xe -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_stats"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_car_luxury"
                        android:contentDescription="Car icon"
                        app:tint="@color/vang_gold"/>

                    <TextView
                        android:id="@+id/txtTongXeDangDo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tong_xe_dang_do"
                        android:textColor="@color/xam_platinum"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <!-- Thẻ 2: Chỗ trống -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_stats"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_parking_empty"
                        android:contentDescription="Empty icon"/>

                    <TextView
                        android:id="@+id/txtChoTrong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cho_trong"
                        android:textColor="@color/xam_platinum"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <!-- Thẻ 3: Doanh thu -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_stats"
                    android:padding="12dp"
                    android:gravity="center"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_money"
                        android:contentDescription="Money icon"
                        app:tint="@color/vang_gold"/>

                    <TextView
                        android:id="@+id/txtDoanhThuHomNay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="450K"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/doanh_thu_hom_nay"
                        android:textColor="@color/xam_platinum"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- SƠ ĐỒ BÃI ĐỖ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Tiêu đề -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_dashboard"
                        android:contentDescription="Dashboard icon"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/so_do_bai_do"
                        android:textColor="@color/trang_tinh_khiet"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#40D4AF37"
                        android:layout_marginStart="16dp"/>

                </LinearLayout>

                <!-- Grid 2 cột cho 6 chỗ đỗ -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewChoDo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

            </LinearLayout>

            <!-- MENU NHANH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Tiêu đề -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_nhanh"
                    android:textColor="@color/trang_tinh_khiet"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- ========== HÀNG 1: 3 NÚT CŨ ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginBottom="12dp">

                    <!-- Nút Xe vào/ra -->
                    <LinearLayout
                        android:id="@+id/btnXeVaoRa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_stats"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_car_luxury"
                            android:contentDescription="Xe vào ra"
                            app:tint="@color/vang_gold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/xe_vao_ra"
                            android:textColor="@color/trang_tinh_khiet"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- Nút Lịch sử -->
                    <LinearLayout
                        android:id="@+id/btnLichSu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_stats"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_history"
                            android:contentDescription="Lịch sử"
                            app:tint="@color/vang_gold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lich_su"
                            android:textColor="@color/trang_tinh_khiet"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- Nút Thống kê -->
                    <LinearLayout
                        android:id="@+id/btnThongKe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_stats"
                        android:padding="16dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_chart"
                            android:contentDescription="Thống kê"
                            app:tint="@color/vang_gold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/thong_ke"
                            android:textColor="@color/trang_tinh_khiet"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- ========== HÀNG 2: NÚT MỚI - SƠ ĐỒ REALTIME ========== -->
                <LinearLayout
                    android:id="@+id/btnSoDoRealtime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_stats"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:elevation="4dp">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_parking_info"
                        android:background="@drawable/bg_gradient_gold"
                        android:padding="14dp"
                        android:contentDescription="Sơ đồ Realtime"/>

                    <!-- Text -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 Sơ đồ Realtime"
                            android:textColor="@color/trang_tinh_khiet"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem trạng thái 6 chỗ đỗ realtime"
                            android:textColor="@color/xam_platinum"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                    <!-- Arrow -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="Arrow"
                        app:tint="@color/vang_gold"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- ========== THÊM NAVIGATION VIEW ========== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_gradient_luxury"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_navigation"
        app:itemIconTint="@color/vang_gold"
        app:itemTextColor="@color/trang_tinh_khiet"/>

</androidx.drawerlayout.widget.DrawerLayout>