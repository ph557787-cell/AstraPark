<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_luxury"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- HEADER: Biển số + Trạng thái -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Biển số -->
        <TextView
            android:id="@+id/txtBienSo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="51A-123.45"
            android:textColor="@color/vang_gold"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Badge trạng thái -->
        <TextView
            android:id="@+id/txtTrangThai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐANG ĐỖ"
            android:textColor="@color/den_sang_trong"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_dang_do"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

    </LinearLayout>

    <!-- THÔNG TIN CHI TIẾT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <!-- Thời gian vào -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_time_in"
                app:tint="@color/xam_platinum"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vào: "
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/txtThoiGianVao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:30 - 12/01/2024"
                android:textColor="@color/trang_tinh_khiet"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Thời gian ra -->
        <LinearLayout
            android:id="@+id/layoutThoiGianRa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_time_out"
                app:tint="@color/xam_platinum"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ra:  "
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/txtThoiGianRa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17:45 - 12/01/2024"
                android:textColor="@color/trang_tinh_khiet"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Thời gian đỗ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/xam_platinum"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thời gian: "
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/txtThoiGianDo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h 15p"
                android:textColor="@color/trang_tinh_khiet"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Chỗ đỗ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_parking"
                app:tint="@color/xam_platinum"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chỗ đỗ: "
                android:textColor="@color/xam_platinum"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/txtChoDo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A-12"
                android:textColor="@color/trang_tinh_khiet"
                android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#20D4AF37"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <!-- FOOTER: Tiền + Phương thức -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Tiền -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_money"
                app:tint="@color/vang_gold"/>

            <TextView
                android:id="@+id/txtTien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50,000 VNĐ"
                android:textColor="@color/vang_gold"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- Phương thức -->
        <TextView
            android:id="@+id/txtPhuongThuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💵 Tiền mặt"
            android:textColor="@color/xam_platinum"
            android:textSize="12sp"
            android:background="@drawable/bg_rounded_dark"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

    </LinearLayout>

</LinearLayout>