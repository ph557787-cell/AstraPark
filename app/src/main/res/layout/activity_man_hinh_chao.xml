<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình chào sang trọng -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_luxury"
    android:id="@+id/layoutChinh">

    <!-- Hiệu ứng sao lấp lánh (optional - có thể thêm sau) -->

    <!-- Logo và thông tin app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:id="@+id/layoutNoiDung">

        <!-- Logo AstraPark -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/ic_logo_astrapark"
            android:contentDescription="@string/ten_app"
            android:scaleType="fitCenter"/>

        <!-- Tên app -->
        <TextView
            android:id="@+id/txtTenApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ten_app"
            android:textSize="42sp"
            android:textColor="@color/vang_gold"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.15"
            android:layout_marginTop="24dp"/>

        <!-- Đường gạch dưới trang trí -->
        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:background="@drawable/bg_gradient_gold"
            android:layout_marginTop="12dp"/>

        <!-- Slogan -->
        <TextView
            android:id="@+id/txtSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/slogan"
            android:textSize="16sp"
            android:textColor="@color/xam_platinum"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp"/>

        <!-- Icon xe cao cấp -->
        <ImageView
            android:id="@+id/imgCarIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_car_luxury"
            android:layout_marginTop="32dp"
            android:contentDescription="Car Icon"/>

    </LinearLayout>

    <!-- Phiên bản app ở dưới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="32dp">

        <!-- Progress bar loading -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:progressTint="@color/vang_gold"
            android:indeterminateTint="@color/vang_gold"/>

        <!-- Text phiên bản -->
        <TextView
            android:id="@+id/txtPhienBan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phien_ban"
            android:textSize="12sp"
            android:textColor="@color/xam_platinum"
            android:fontFamily="sans-serif-light"
            android:layout_marginTop="16dp"
            android:alpha="0.7"/>

    </LinearLayout>

</RelativeLayout>