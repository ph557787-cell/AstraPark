<?xml version="1.0" encoding="utf-8"?>
<!-- Nút bấm sang trọng -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Khi nhấn -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#B8941E"
                android:endColor="#9A7A19"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="#D4AF37"/>
        </shape>
    </item>

    <!-- Bình thường -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#D4AF37"
                android:endColor="#B8941E"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#FFD700"/>
        </shape>
    </item>
</selector>